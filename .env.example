# ─────────────────────────────────────────────────────────────────────────────
# AIR ZEN Flow — Variables d'environnement (MODÈLE)
#
# Ce fichier ne contient AUCUN secret : ce sont seulement les NOMS des variables.
# Copiez-le et renseignez les vraies valeurs dans le tableau de bord Render
# (Environment Variables). Ne mettez jamais de vraies clés dans Git.
# ─────────────────────────────────────────────────────────────────────────────

# --- Firebase, côté client (sans danger à exposer, préfixe NEXT_PUBLIC_) ---
# À récupérer dans : Console Firebase > Paramètres du projet > Vos applications (Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase, côté serveur (SECRET — jamais exposé au navigateur) ---
# Clé de compte de service (fichier JSON), à coller sur une seule ligne.
# À récupérer dans : Console Firebase > Paramètres > Comptes de service > Générer une clé privée
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Google Calendar (Étape 8 — lecture seule, pas encore utilisé en MVP) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- API Anthropic (Étape 6 — découpage des sous-tâches, pas encore utilisé en MVP) ---
ANTHROPIC_API_KEY=
